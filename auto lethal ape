    TeleportToTarget()
    TeleportBtn.Text = "✅ ĐÃ TELEPORT + FLOAT!"
    task.delay(1.5, function()
        if TeleportBtn and TeleportBtn.Parent then
            TeleportBtn.Text = "🚀 TELEPORT + FLOAT"
