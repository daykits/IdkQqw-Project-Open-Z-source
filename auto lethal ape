    FloatBtn.Text = "🪂 FLOAT: ON"
    FloatBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
end)

-- Xử lý nút Float
FloatBtn.MouseButton1Click:Connect(function()
    if floating then
        StopFloating()
        FloatBtn.Text = "🪂 FLOAT: OFF"
        FloatBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 180)
    else
        -- Nếu chưa ở tọa độ, teleport trước
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local dist = (rootPart.Position - TARGET_POSITION).Magnitude
            if dist > 50 then
                rootPart.CFrame = CFrame.new(TARGET_POSITION)
                task.wait(0.1)
            end
        end
        StartFloating()
        FloatBtn.Text = "🪂 FLOAT: ON"
        FloatBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    end
end)

-- === Kéo thả menu ===
local dragging = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- === Thu nhỏ / Mở rộng ===
local minimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        MainFrame.Size = UDim2.new(0, 230, 0, 30)
        CoordLabel.Visible = false
        TeleportBtn.Visible = false
        FloatBtn.Visible = false
        MinimizeBtn.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 230, 0, 160)
        CoordLabel.Visible = true
        TeleportBtn.Visible = true
        FloatBtn.Visible = true
        MinimizeBtn.Text = "—"
    end
end)

-- Phím tắt: T = teleport + float, F = bật/tắt float
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.T then
        TeleportToTarget()
        FloatBtn.Text = "🪂 FLOAT: ON"
        FloatBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
    elseif input.KeyCode == Enum.KeyCode.F then
        if floating then
            StopFloating()
            FloatBtn.Text = "🪂 FLOAT: OFF"
            FloatBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 180)
        else
            StartFloating()
            FloatBtn.Text = "🪂 FLOAT: ON"
            FloatBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        end
    end
end)

-- Tự động reset khi nhân vật hồi sinh
LocalPlayer.CharacterAdded:Connect(function()
    if floating then
        floating = false
        if floatConnection then
            floatConnection:Disconnect()
            floatConnection = nil
        end
        task.wait(1)
        StartFloating()
    end
end)

