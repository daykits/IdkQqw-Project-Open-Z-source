-- Hàm teleport
local function TeleportToTarget()
    local character = LocalPlayer.Character
    if not character then
        warn("Không tìm thấy nhân vật!")
        return
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        warn("Không tìm thấy HumanoidRootPart!")
        return
    end
    
    -- Teleport trực tiếp
    rootPart.CFrame = CFrame.new(TARGET_POSITION)
    
    -- Hiệu ứng thông báo
    TeleportBtn.Text = "✅ ĐÃ TELEPORT!"
    TeleportBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    
    task.delay(1.5, function()
        if TeleportBtn and TeleportBtn.Parent then
            TeleportBtn.Text = "🚀 TELEPORT NOW"
            TeleportBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 100)
        end
    end)
end

-- Hiệu ứng hover
TeleportBtn.MouseEnter:Connect(function()
    TweenService:Create(TeleportBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(0, 200, 130)
    }):Play()
end)

TeleportBtn.MouseLeave:Connect(function()
    TweenService:Create(TeleportBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(0, 150, 100)
    }):Play()
end)

TeleportBtn.MouseButton1Click:Connect(TeleportToTarget)

-- === Kéo thả menu ===
local dragging = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- === Thu nhỏ / Mở rộng ===
local minimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        MainFrame.Size = UDim2.new(0, 220, 0, 30)
        CoordLabel.Visible = false
        TeleportBtn.Visible = false
        MinimizeBtn.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 220, 0, 110)
        CoordLabel.Visible = true
        TeleportBtn.Visible = true
        MinimizeBtn.Text = "—"
    end
end)

-- Phím tắt: nhấn T để teleport nhanh
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        TeleportToTarget()
    end
end)

