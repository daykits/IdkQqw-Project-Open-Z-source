local toastToken = 0
local function showToast(msg, color)
    toastToken += 1
    local myToken = toastToken
    Toast.Text = msg
    Toast.BackgroundColor3 = color or Color3.fromRGB(0, 180, 220)
    Toast.Visible = true
    Toast.Position = UDim2.new(0.5, -140, 1, -40)
    tween(Toast, TweenInfo.new(0.25), {
        BackgroundTransparency = 0,
        TextTransparency = 0,
        Position = UDim2.new(0.5, -140, 1, -58),
    })
    task.delay(2.5, function()
        if toastToken == myToken then
            local t = tween(Toast, TweenInfo.new(0.25), {
                BackgroundTransparency = 1,
                TextTransparency = 1,
                Position = UDim2.new(0.5, -140, 1, -40),
            })
            t.Completed:Connect(function()
                if toastToken == myToken then Toast.Visible = false end
            end)
        end
    end)
end

