-- Load theme đã lưu (nếu có)
local CONFIG_FILE = "ScriptMenuHubPro_Theme.json"
local function loadTheme()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    if not isfile(CONFIG_FILE) then return end
    local ok, raw = pcall(readfile, CONFIG_FILE)
    if not ok or not raw then return end
    local ok2, data = pcall(function()
        if type(HttpService) == "table" or type(game.GetService) == "function" then
            return game:GetService("HttpService"):JSONDecode(raw)
        end
    end)
    if not ok2 or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if k:match("Color$") and type(v) == "table" then
            Theme[k] = Color3.new(v[1] or 0, v[2] or 0, v[3] or 0)
        elseif Theme[k] ~= nil then
            Theme[k] = v
        end
    end
end
loadTheme()

local function saveTheme()
    if type(writefile) ~= "function" then return end
    local ok, HttpService = pcall(function() return game:GetService("HttpService") end)
    if not ok then return end
    local serialized = {}
    for k, v in pairs(Theme) do
        if typeof(v) == "Color3" then
            serialized[k] = { v.R, v.G, v.B }
        else
            serialized[k] = v
        end
    end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(serialized))
    end)
end

