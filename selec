local TweenService       = game:GetService("TweenService")
local UserInputService   = game:GetService("UserInputService")
local Lighting           = game:GetService("Lighting")

local function new(cls, props, parent)
    local i = Instance.new(cls)
    if props then for k, v in pairs(props) do i[k] = v end end
    if parent then i.Parent = parent end
    return i
end

local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function stroke(p, c, t) return new("UIStroke", { Color = c, Thickness = t or 1 }, p) end
local function tween(inst, info, goal)
    local t = TweenService:Create(inst, info, goal); t:Play(); return t
end

local function getGuiParent()
    local gethui = (getgenv and getgenv().gethui) or rawget(_G, "gethui")
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then return hui end
    end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then
        local ok2 = pcall(function() return core:GetChildren() end)
        if ok2 then return core end
    end
    return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

