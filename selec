local running = false

local function createItem(data, index)
    local Y = HEADER_H + PADDING + (index - 1) * ROW_H
    local Btn = new("TextButton", {
        Parent = Main,
        Name = "Item_" .. index,
        BackgroundColor3 = BG_ITEM,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        Position = UDim2.new(0, PADDING, 0, Y),
        Size = UDim2.new(1, -PADDING * 2, 0, ROW_H - 8),
        ClipsDescendants = true,
    }, Main)
    corner(Btn, 12)
    local BtnStroke = stroke(Btn, STROKE, 1)

    -- accent bar trái
    local Accent = new("Frame", {
        Parent = Btn,
        BackgroundColor3 = data.color,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 6, 0.5, -18),
        Size = UDim2.new(0, 4, 0, 36),
    }, Btn)
    corner(Accent, 2)

    -- icon box
    local Icon = new("TextLabel", {
        Parent = Btn,
        BackgroundColor3 = data.color,
        Text = data.icon,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Position = UDim2.new(0, 18, 0.5, -20),
        Size = UDim2.new(0, 40, 0, 40),
    }, Btn)
    corner(Icon, 10)

    -- tên
    local Name = new("TextLabel", {
        Parent = Btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 68, 0, 8),
        Size = UDim2.new(1, -110, 0, 22),
        Text = data.name,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = TEXT_MAIN,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, Btn)

    -- mô tả
    local Desc = new("TextLabel", {
        Parent = Btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 68, 0, 30),
        Size = UDim2.new(1, -110, 0, 18),
        Text = data.desc,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = TEXT_DIM,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, Btn)

    -- arrow
    local Arrow = new("TextLabel", {
        Parent = Btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -30, 0.5, -10),
        Size = UDim2.new(0, 20, 0, 20),
        Text = "›",
        Font = Enum.Font.GothamBold,
        TextSize = 22,
        TextColor3 = Color3.fromRGB(100, 100, 130),
    }, Btn)

    -- hover
    Btn.MouseEnter:Connect(function()
        if running then return end
        tween(Btn, TweenInfo.new(0.15), { BackgroundColor3 = BG_ITEM_HOVER })
        tween(BtnStroke, TweenInfo.new(0.15), { Color = data.color })
        Arrow.TextColor3 = data.color
    end)
    Btn.MouseLeave:Connect(function()
        if running then return end
        tween(Btn, TweenInfo.new(0.15), { BackgroundColor3 = BG_ITEM })
        tween(BtnStroke, TweenInfo.new(0.15), { Color = STROKE })
        Arrow.TextColor3 = Color3.fromRGB(100, 100, 130)
    end)

    -- click chạy
    Btn.MouseButton1Click:Connect(function()
        if running then
            showToast("⏳ Đang chạy script khác...", Color3.fromRGB(200, 130, 40))
            return
        end
        if data.url == "" or not data.url then
            showToast("⚠ Slot này chưa có URL — dán vào SCRIPTS", Color3.fromRGB(200, 60, 60))
            return
        end

        running = true
        Arrow.Text = "⏳"
        showToast("🚀 Đang chạy: " .. data.name)

        task.spawn(function()
            local ok, err = pcall(function()
                local src = game:HttpGet(data.url)
                local fn, compileErr = loadstring(src)
                if not fn then error("loadstring: " .. tostring(compileErr)) end
                fn()
            end)
            if ok then
                showToast("✅ " .. data.name .. " đã chạy", Color3.fromRGB(0, 180, 120))
                Arrow.Text = "✓"
            else
                showToast("❌ Lỗi: " .. tostring(err), Color3.fromRGB(220, 50, 70))
                warn("[ScriptMenuHubPro] " .. data.name .. ": " .. tostring(err))
                Arrow.Text = "✕"
            end
            task.delay(1.8, function()
                if Btn.Parent then
                    Arrow.Text = "›"
                    running = false
                end
            end)
        end)
    end)

    return Btn
end

