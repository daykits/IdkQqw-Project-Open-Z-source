-- TOAST THÔNG BÁO
-- ============================================
local Toast = Instance.new("TextLabel")
Toast.Size = UDim2.new(0, 260, 0, 44)
Toast.Position = UDim2.new(0.5, -130, 1, -60)
Toast.BackgroundColor3 = Color3.fromRGB(0, 180, 220)
Toast.Text = ""
Toast.Font = Enum.Font.GothamBold
Toast.TextSize = 13
Toast.TextColor3 = Color3.fromRGB(255, 255, 255)
Toast.Visible = false
Toast.Parent = ScreenGui

local ToastCorner = Instance.new("UICorner")
ToastCorner.CornerRadius = UDim.new(0, 10)
ToastCorner.Parent = Toast

local toastToken = 0
local function showToast(msg)
    toastToken = toastToken + 1
    local myToken = toastToken
    Toast.Text = msg
    Toast.Visible = true
    task.delay(2.5, function()
        if toastToken == myToken then
            Toast.Visible = false
        end
    end)
end

-- ============================================
-- CHẠY SCRIPT KHI CLICK
-- ============================================
local function runScript(data)
    showToast("🚀 Đang chạy: " .. data.name)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(data.url))()
        end)
        if not ok then
            showToast("❌ Lỗi: " .. tostring(err))
            warn("[Menu Script] Lỗi khi chạy " .. data.name .. ": " .. tostring(err))
        end
    end)
end

-- Tạo các nút
for i, data in ipairs(scripts) do
    local btn = createButton(data, i)
    btn.MouseButton1Click:Connect(function()
        runScript(data)
    end)
end

showToast("✅ Menu đã load thành công!")
