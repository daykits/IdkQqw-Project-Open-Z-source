        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 120, 1, 0),
        Text = label,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(220, 220, 240),
    })
    local preview = new("Frame", {
        Parent = row,
        BackgroundColor3 = getColor(),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 125, 0.5, -10),
        Size = UDim2.new(0, 40, 0, 20),
    })
    corner(preview, 5)
    stroke(preview, Color3.fromRGB(80, 80, 110), 1)

    local box = new("TextBox", {
        Parent = row,
        BackgroundColor3 = Color3.fromRGB(40, 40, 60),
        BorderSizePixel = 0,
        Text = colorToHex(getColor()),
        Font = Enum.Font.Code,
        TextSize = 12,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Position = UDim2.new(1, -90, 0.5, -10),
        Size = UDim2.new(0, 90, 0, 20),
        ClearTextOnFocus = false,
    })
    corner(box, 5)
    local boxStroke = stroke(box, Color3.fromRGB(80, 80, 110), 1)

    box.FocusLost:Connect(function()
        local c = hexToColor(box.Text)
        if c then
            setColor(c)
            preview.BackgroundColor3 = c
            box.Text = colorToHex(c)
        else
            box.Text = colorToHex(getColor())
        end
    end)
    box.MouseEnter:Connect(function()
        tween(boxStroke, TweenInfo.new(0.15), { Color = Theme.accent })
    end)
    box.MouseLeave:Connect(function()
        tween(boxStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(80, 80, 110) })
    end)
    return row
end

local function toggleSettings()
    SettingsOpen = not SettingsOpen
    if not SettingsPanel then return end
    if SettingsOpen then
        SettingsPanel.Visible = true
        SettingsPanel.Position = UDim2.new(1, 12, 0, 0)
        tween(SettingsPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, 12, 0, 0),
        })
    else
        local t = tween(SettingsPanel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 60, 0, 0),
        })
        t.Completed:Connect(function()
            if not SettingsOpen then SettingsPanel.Visible = false end
        end)
    end
end
SettingsBtn.MouseButton1Click:Connect(toggleSettings)

