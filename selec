local function createButton(data, index)
    local Btn = Instance.new("TextButton")
    Btn.Name = "Btn_" .. index
    Btn.Size = UDim2.new(1, -30, 0, 58)
    Btn.Position = UDim2.new(0, 15, 0, 55 + (index - 1) * 68)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 68)
    Btn.BorderSizePixel = 0
    Btn.AutoButtonColor = false
    Btn.Text = ""
    Btn.Parent = Main

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 10)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(60, 60, 90)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = Btn

    -- Thanh màu bên trái
    local Accent = Instance.new("Frame")
    Accent.Size = UDim2.new(0, 4, 1, -16)
    Accent.Position = UDim2.new(0, 6, 0, 8)
    Accent.BackgroundColor3 = data.color
    Accent.BorderSizePixel = 0
    Accent.Parent = Btn

    local AccentCorner = Instance.new("UICorner")
    AccentCorner.CornerRadius = UDim.new(1, 0)
    AccentCorner.Parent = Accent

    -- Icon
    local Icon = Instance.new("TextLabel")
    Icon.Size = UDim2.new(0, 40, 0, 40)
    Icon.Position = UDim2.new(0, 18, 0.5, -20)
    Icon.BackgroundColor3 = data.color
    Icon.Text = data.icon
    Icon.Font = Enum.Font.GothamBold
    Icon.TextSize = 20
    Icon.TextColor3 = Color3.fromRGB(255, 255, 255)
    Icon.Parent = Btn

    local IconCorner = Instance.new("UICorner")
    IconCorner.CornerRadius = UDim.new(0, 10)
    IconCorner.Parent = Icon

    -- Tên script
    local Name = Instance.new("TextLabel")
    Name.Size = UDim2.new(1, -80, 0, 22)
    Name.Position = UDim2.new(0, 68, 0, 8)
    Name.BackgroundTransparency = 1
    Name.Text = data.name
    Name.TextXAlignment = Enum.TextXAlignment.Left
    Name.Font = Enum.Font.GothamBold
    Name.TextSize = 13
    Name.TextColor3 = Color3.fromRGB(255, 255, 255)
    Name.Parent = Btn

    -- Mô tả
    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, -80, 0, 18)
    Desc.Position = UDim2.new(0, 68, 0, 30)
    Desc.BackgroundTransparency = 1
    Desc.Text = data.desc
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 11
    Desc.TextColor3 = Color3.fromRGB(150, 150, 170)
    Desc.Parent = Btn

    -- Mũi tên
    local Arrow = Instance.new("TextLabel")
    Arrow.Size = UDim2.new(0, 20, 0, 20)
    Arrow.Position = UDim2.new(1, -30, 0.5, -10)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "›"
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 22
    Arrow.TextColor3 = Color3.fromRGB(100, 100, 130)
    Arrow.Parent = Btn

    -- Hiệu ứng hover
    Btn.MouseEnter:Connect(function()
        Btn.BackgroundColor3 = Color3.fromRGB(55, 55, 85)
        BtnStroke.Color = data.color
        Arrow.TextColor3 = data.color
    end)
    Btn.MouseLeave:Connect(function()
        Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 68)
        BtnStroke.Color = Color3.fromRGB(60, 60, 90)
        Arrow.TextColor3 = Color3.fromRGB(100, 100, 130)
    end)

    return Btn
end

