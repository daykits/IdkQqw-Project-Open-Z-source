-- ============================================
-- AUTO PRESS E + INSTANT PICKUP - MỌI LÚC MỌI NƠI
-- ============================================

local Workspace        = game:GetService("Workspace")
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local VirtualInput    = game:GetService("VirtualInputManager")
local LocalPlayer      = Players.LocalPlayer

-- Bật = true, Tắt = false
getgenv().InstantPickup   = true   -- đặt HoldDuration = 0
getgenv().AutoPressE      = true   -- tự động nhấn E
getgenv().AutoPressDelay  = 0.05   -- khoảng nghỉ giữa các lần nhấn
getgenv().AutoPressRadius = 15     -- tầm quét (studs)

-- ============================================
-- PHẦN 1: ĐẶT HoldDuration = 0 CHO MỌI PROMPT
-- ============================================

local function makeInstant(prompt)
    if not getgenv().InstantPickup then return end
    if prompt:IsA("ProximityPrompt") then
        pcall(function()
            prompt.HoldDuration         = 0
            prompt.RequiresLineOfSight  = false
        end)
    end
end

local function scanAll()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        makeInstant(obj)
    end
end

scanAll()

Workspace.DescendantAdded:Connect(function(obj)
    makeInstant(obj)
    if obj:IsA("ProximityPrompt") then
        -- Theo dõi nếu game cố tình đổi lại HoldDuration
        obj:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if getgenv().InstantPickup and obj.HoldDuration ~= 0 then
                obj.HoldDuration = 0
            end
        end)
    end
end)

-- Vòng lặp quét định kỳ (chống miss)
task.spawn(function()
    while task.wait(1) do
        if getgenv().InstantPickup then
            pcall(scanAll)
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    scanAll()
end)

-- ============================================
-- PHẦN 2: AUTO NHẤN E MỌI LÚC MỌI NƠI
-- ============================================

-- Hàm nhấn E 1 lần
local function pressE()
    pcall(function()
        VirtualInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- Hàm kích hoạt prompt trực tiếp (không cần bấm E)
local function firePrompt(prompt)
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        elseif prompt and prompt.Triggered then
            prompt:InputHoldBegin()  -- nếu game dùng InputHold
        end
    end)
end

-- Vòng lặp auto nhấn E + auto fire prompt
task.spawn(function()
    while task.wait(getgenv().AutoPressDelay) do
        if not getgenv().AutoPressE then continue end

        local char = LocalPlayer.Character
        if not char then continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        -- Quét mọi ProximityPrompt trong game
        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    local parent = prompt.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - root.Position).Magnitude
                        if dist <= getgenv().AutoPressRadius then
                            -- Cách 1: nhấn E
                            pressE()
                            -- Cách 2: kích hoạt trực tiếp (dự phòng)
                            firePrompt(prompt)
                        end
                    end
                end)
            end
        end
    end
end)

-- ============================================
-- PHẦN 3: BẮT MỌI PROMPT MỚI XUẤT HIỆN GẦN MÌNH
-- ============================================

Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") and getgenv().AutoPressE then
        task.spawn(function()
            -- Thử kích hoạt ngay khi prompt xuất hiện
            task.wait(0.1)
            firePrompt(obj)
        end)
    end
end)

-- ============================================
-- PHẦN 4: LẮNG NGHE PHÍM TẮT BẬT/TẮT
-- ============================================

local UserInput = game:GetService("UserInputService")
UserInput.InputBegan:Connect(function(input, processed)
    if processed then return end
    -- Bấm phím RightControl để bật/tắt auto E
    if input.KeyCode == Enum.KeyCode.RightControl then
        getgenv().AutoPressE = not getgenv().AutoPressE
        print("[AutoPressE] " .. (getgenv().AutoPressE and "BẬT" or "TẮT"))
    end
end)

print("[InstantPickup] Đã bật! Auto nhấn E mọi lúc mọi nơi.")
print("Bấm RightCtrl để bật/tắt Auto E.")
