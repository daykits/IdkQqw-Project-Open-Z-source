local function onDungeonComplete()
    local boss = findBossGlobal("Cupid Queen")
    local alive = boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0
    if alive then
        task.spawn(function() fightCupidQueen(AD.loopID); onDungeonComplete() end)
        return
    end
    cupidTrackActive = false
    cupidTrackTarget = nil
    AD.status = "replay"
    lockedPosition = nil

    if AD.autoStoreFruit then
        task.wait(2)
        storeFruitNow()
        task.wait(1)
    end
    task.wait(7)

    if not AD.autoReplay then
        AD.status = "idle"
        AD.enabled = false
        if _G.MiniDungeonToggle then _G.MiniDungeonToggle:Set(false) end
        return
    end

    pcall(function()
        TeleportService:TeleportToPlaceInstance(6360478118, "2c6cd3f9-8a53-4cb8-9b8e-b2c8259c29c9", LP)
    end)
    task.wait(8)
    AD.startDungeon()
end

