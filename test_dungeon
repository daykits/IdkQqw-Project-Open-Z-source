-- KILL ALL
-- ============================================================
local function killAllNPCsAtPos(pos, radius)
    radius = radius or 120
    local killed = {}
    while AD.enabled do
        if getgenv().adStatuePhaseActive then lockedPosition = nil; break end
        local rp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not rp then break end

        local allNPCs = {}
        local seen = {}
        for _, d in ipairs(getAllNearbyNPCs(pos, radius)) do
            if not killed[d.npc] and not seen[d.npc] then
                seen[d.npc] = true; table.insert(allNPCs, d)
            end
        end
        for _, d in ipairs(getAllNearbyNPCs(rp.Position, radius)) do
            if not killed[d.npc] and not seen[d.npc] then
                seen[d.npc] = true; table.insert(allNPCs, d)
            end
        end

        if getgenv().adStatuePhaseActive or statuesNeedKilling() then
            lockedPosition = nil; getgenv().adStatuePhaseActive = true; break
        end
        if #allNPCs == 0 then lockedPosition = nil; break end

        table.sort(allNPCs, function(a, b)
            return (rp.Position - a.hrp.Position).Magnitude < (rp.Position - b.hrp.Position).Magnitude
        end)

        local target = allNPCs[1]
        local hrp = target.hrp
        if hrp then
            local tName = string.lower(target.npc.Name)
            local isCupidQueen = (tName == "cupid queen")
            if isCupidQueen then
                if hookedBossNPC ~= target.npc then
                    if hookedBossCleanup then hookedBossCleanup() end
                    hookedBossCleanup = startBossHook(target.npc, CUPID_ANIMS)
                    hookedBossNPC = target.npc
                end
            end

            local lockedY = hrp.Position.Y + AD.upHeight
            if getgenv().adSkipHit then
                if isCupidQueen then
                    cupidTrackTarget = target.npc; cupidTrackActive = true
                else
                    lockedPosition = nil
                end
                task.wait(0.05); continue
            end

            if isCupidQueen then
                cupidTrackTarget = target.npc; cupidTrackActive = true
            else
                local combatPos = Vector3.new(hrp.Position.X, lockedY, hrp.Position.Z)
                lockedPosition = nil
                if (rp.Position - combatPos).Magnitude > 3 then
                    DoSafeTeleport(combatPos)
                end
                lockedPosition = combatPos
            end

            if not isCupidQueen then task.wait(0.15) end
            attackNPC(target.npc)
            local humAfter = target.npc:FindFirstChild("Humanoid")
            if not humAfter or humAfter.Health <= 0 then
                killed[target.npc] = true
            end
        end
        task.wait(0.05)
    end
end

