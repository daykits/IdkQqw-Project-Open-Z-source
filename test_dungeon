local function getWPPos(wp)
    if wp.type == "patrol" then
        local pA = typeof(wp.posA) == "CFrame" and wp.posA.Position or wp.posA
        local pB = typeof(wp.posB) == "CFrame" and wp.posB.Position or wp.posB
        return (pA + pB) / 2
    end
    return typeof(wp.pos) == "CFrame" and wp.pos.Position or wp.pos
end

local function findNearestWaypointIndex()
    local rp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not rp then return 1 end
    local pp = rp.Position
    local bestIdx = 1
    local bestDist = math.huge
    for i, wp in ipairs(DUNGEON_WAYPOINTS) do
        local d = (pp - getWPPos(wp)).Magnitude
        if d < bestDist then bestDist = d; bestIdx = i end
    end
    if bestDist > 400 then return 1 end
    return bestIdx
end

