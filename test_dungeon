local function statuesNeedKilling()
    local obj = LP.PlayerGui:FindFirstChild("Objectives")
    if not obj then return false end
    local main = obj:FindFirstChild("Main")
    if not main then return false end
    return main:FindFirstChild("Take down the Statues") ~= nil
end

