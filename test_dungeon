    isTeleporting = false
end

AD.startDungeon = function()
    if AD.enabled then return end
    AD.enabled = true
    AD.loopID = AD.loopID + 1
    local loopID = AD.loopID
    canAttack = true
    AD.status = "idle"
    getgenv().adSkipHit = false
    getgenv().adCupidPhase2Permanent = false
    antiKBEnabled = false
    lockedPosition = nil
    weaponEquipped = false

    AD.status = "waiting"
    for i = 10, 1, -1 do
        if not AD.enabled or AD.loopID ~= loopID then return end
        Library.Notify(("Auto Dungeon starts in %ds..."):format(i), 1)
        task.wait(1)
    end
    if not AD.enabled or AD.loopID ~= loopID then return end
    AD.status = "idle"

    -- Nếu đang gần boss → đánh luôn
    local cupidNearby = findBossGlobal("Cupid Queen")
    if cupidNearby then
        local ch = cupidNearby:FindFirstChild("HumanoidRootPart")
        local rp0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if ch and rp0 and (rp0.Position - ch.Position).Magnitude < 800 then
            task.spawn(function()
                fightCupidQueen(loopID)
                AD.enabled = false
                task.spawn(onDungeonComplete)
            end)
            return
        end
    end

    local leoNearby = findBossGlobal("Leo")
    if leoNearby then
        local lh = leoNearby:FindFirstChild("HumanoidRootPart")
        local rp0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if lh and rp0 and (rp0.Position - lh.Position).Magnitude < 400 then
            task.spawn(function()
                fightBoss(loopID, "Leo")
                if AD.enabled and AD.loopID == loopID then
                    local function lm(pos)
                        lockedPosition = nil
                        DoSafeTeleport(pos)
                        local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if r then lockedPosition = r.Position end
                        task.wait(0.5)
                    end
                    lm(Vector3.new(-1091.291, 506.375, -4424.925))
                    lm(Vector3.new(-1092.546, 568.555, -4497.691))
                    lm(Vector3.new(-1092.954, 631.463, -4588.583))
                    lm(Vector3.new(-1091.032, 639.903, -4747.583))
                    lm(Vector3.new(-1033.052, 667.073, -5048.281))
                    lockedPosition = nil
                    fightCupidQueen(loopID)
                end
                AD.enabled = false
                task.spawn(onDungeonComplete)
            end)
            return
        end
    end

    local startIdx = findNearestWaypointIndex()
    equipWeapon()

    task.spawn(function()
        for i = startIdx, #DUNGEON_WAYPOINTS do
            if not AD.enabled or AD.loopID ~= loopID then break end
            local wp = DUNGEON_WAYPOINTS[i]
            if wp.type == "patrol" then
                local posA = typeof(wp.posA) == "CFrame" and wp.posA.Position or wp.posA
                local posB = typeof(wp.posB) == "CFrame" and wp.posB.Position or wp.posB
                local dur = wp.duration or 30
                local startT = tick()
                local goB = true
                while AD.enabled and AD.loopID == loopID and (tick() - startT) < dur do
                    local t = goB and posB or posA
                    DoSafeTeleport(t); task.wait(0.5)
                    if not AD.enabled or AD.loopID ~= loopID then break end
                    killAllNPCsAtPos(t, 120)
                    goB = not goB
                end
            else
                local tp = typeof(wp.pos) == "CFrame" and wp.pos.Position or wp.pos
                DoSafeTeleport(tp); task.wait(0.5)
                if not AD.enabled or AD.loopID ~= loopID then break end
                killAllNPCsAtPos(tp, 120); task.wait(0.5)
                if not AD.enabled or AD.loopID ~= loopID then break end
                killAllNPCsAtPos(tp, 120)
            end
        end
        if not AD.enabled or AD.loopID ~= loopID then return end

        fightBoss(loopID, "Leo")
        if not AD.enabled or AD.loopID ~= loopID then return end

        local function lm(pos)
            lockedPosition = nil
            DoSafeTeleport(pos)
            local rp2 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if rp2 then lockedPosition = rp2.Position end
            task.wait(0.5)
        end
        lm(Vector3.new(-1091.291, 506.375, -4424.925))
        lm(Vector3.new(-1092.546, 568.555, -4497.691))
        lm(Vector3.new(-1092.954, 631.463, -4588.583))
        lm(Vector3.new(-1091.032, 639.903, -4747.583))
        lm(Vector3.new(-1033.052, 667.073, -5048.281))
        lockedPosition = nil
        fightCupidQueen(loopID)

        AD.status = "complete"
        AD.enabled = false
        task.spawn(onDungeonComplete)
    end)
end

