local function killStatues(loopID)
    AD.status = "statues"
    local isKraken = AD.weapon == "Kraken Blade"
    local wType = isKraken and "Sword" or "Melee"
    local anims = isKraken and KrakenAnims or CombatAnims
    local swSp  = isKraken and 1.4583332538604736 or 1.75
    local sf = workspace:FindFirstChild("Env") and workspace.Env:FindFirstChild("Statues")
    if not sf then return end

    for _, statue in ipairs(sf:GetChildren()) do
        if not AD.enabled or AD.loopID ~= loopID then break end
        if not statuesNeedKilling() then break end
        local hitbox = statue:FindFirstChild("hitbox")
        if not hitbox then continue end

        local savedSpeed = AD.tweenSpeed
        AD.tweenSpeed = 70
        lockedPosition = nil
        DoSafeTeleport(hitbox.Position)
        AD.tweenSpeed = savedSpeed
        lockedPosition = nil
        task.wait(0.3)

        local barrelHP = statue:FindFirstChild("barrelHP")
        while AD.enabled and AD.loopID == loopID and statuesNeedKilling() do
            if not barrelHP or barrelHP.Value <= 0 then break end
            local rp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not rp then break end
            if (rp.Position - hitbox.Position).Magnitude > 5 then
                lockedPosition = nil
                DoSafeTeleport(hitbox.Position)
                lockedPosition = nil
                task.wait(0.1)
                rp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not rp then break end
            end
            if not canAttack then task.wait(0.1) end
            canAttack = false
            antiKBEnabled = true
            for combo = 1, 5 do
                if not AD.enabled or not barrelHP or barrelHP.Value <= 0 then break end
                rp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not rp then break end
                pcall(function()
                    combatRegister:InvokeServer({[1]="swingsfx",[2]=wType,[3]=combo,[4]="Ground",[5]=false,[6]=anims[combo],[7]=swSp,[8]=1.5})
                    combatRegister:InvokeServer({[1]="damage",[2]={hitbox},[3]=wType,[4]={combo,"Ground",wType},[5]=true,[6]=rp.CFrame,aircombo="Ground"})
                end)
                task.wait(AD.comboDelay)
            end
            task.wait(AD.fullComboWait)
            antiKBEnabled = false
            canAttack = true
        end
    end
    getgenv().adStatuePhaseActive = false
end

