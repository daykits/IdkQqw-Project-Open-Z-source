-- Hàm teleport
local function TeleportToTarget()
    local character = game.Players.LocalPlayer.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = CFrame.new(targetPos)
        end
    end
end

-- Hàm bật/tắt teleport
local function ToggleTeleport()
    isTeleporting = not isTeleporting
    
    if isTeleporting then
        -- Cập nhật giao diện
        ToggleButton.Text = "ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        -- Bắt đầu teleport liên tục (mỗi frame)
        if teleportConnection then
            teleportConnection:Disconnect()
        end
        
        teleportConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if isTeleporting then
                TeleportToTarget()
            end
        end)
        
        print("Auto Teleport: ON")
    else
        -- Cập nhật giao diện
        ToggleButton.Text = "OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
        
        -- Dừng teleport
        if teleportConnection then
            teleportConnection:Disconnect()
            teleportConnection = nil
        end
        
        print("Auto Teleport: OFF")
    end
end

-- Gán sự kiện cho nút
ToggleButton.MouseButton1Click:Connect(ToggleTeleport)

-- Thông báo khi load thành công
print("✅ Auto Teleport Script Loaded!")
print(string.format("📍 Target: X: %.2f, Y: %.2f, Z: %.2f", targetPos.X, targetPos.Y, targetPos.Z))
print("🔘 Nhấn nút ON/OFF để bật/tắt teleport.")
