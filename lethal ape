local function makeInstant(prompt)
    if prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0 -- Đặt thời gian giữ về 0
        prompt.RequiresLineOfSight = false -- Không cần nhìn thẳng vào vật phẩm
    end
end

-- Quét tất cả ProximityPrompt hiện có trong game
for _, v in ipairs(workspace:GetDescendants()) do
    makeInstant(v)
end

-- Tự động áp dụng cho vật phẩm mới xuất hiện sau này
workspace.DescendantAdded:Connect(makeInstant)
