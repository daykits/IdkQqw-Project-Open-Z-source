local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Hàm xử lý 1 ProximityPrompt
local function fixPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        -- Bỏ yêu cầu giữ phím
        pcall(function()
            prompt.HoldDuration = 0
        end)

        -- Tự động kích hoạt nếu cần (tùy chọn)
        -- prompt.Triggered:Connect(function() end)
    end
end

-- Quét toàn bộ ProximityPrompt đang có trong game
local function scanAllPrompts()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            fixPrompt(obj)
        end
    end
end

-- Quét lần đầu
scanAllPrompts()

-- Lắng nghe prompt mới xuất hiện
Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        fixPrompt(obj)
    end
end)

print("[Script] Đã tắt HoldDuration cho mọi ProximityPrompt. Bấm E 1 lần là nhặt được.")
